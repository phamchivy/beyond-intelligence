# Copy to .env for local dev. Never commit the real .env.

# No local MinIO -- this service always targets real S3. Leave
# S3_ENDPOINT empty so boto3 resolves the real AWS endpoint for
# S3_REGION below.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-southeast-1
S3_ADDRESSING_STYLE=auto
BUCKET_RAW=raw-assets
BUCKET_PROCESSED=processed-assets
# Single real bucket -- bucket_raw/bucket_processed above become key
# prefixes inside it (see service/storage.py _physical()). The IAM key
# is scoped to this one bucket, not CreateBucket.
S3_BUCKET=beyond-videos

INTERNAL_TOKEN=dev-only-token-change-me

MAX_ASSET_BYTES=26214400
MAX_IMAGE_PIXELS=50000000

TARGET_LONG_EDGE=4096
JPEG_QUALITY=90

CUTOUT_BACKEND=rembg
CUTOUT_MODEL=u2netp
CUTOUT_ROLES=hero,closeup,variant
CUTOUT_CONCURRENCY=2
CUTOUT_TIMEOUT=20

PRESIGN_TTL_SECONDS=3600

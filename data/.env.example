ENVIRONMENT=development

# Real AWS S3: set STORAGE_URL to the bucket, leave STORAGE_ENDPOINT_URL
# empty (or unset it), and set STORAGE_REGION to the bucket's region.
STORAGE_URL=s3://bi-data-dev
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
STORAGE_ADDRESSING_STYLE=auto

DATABASE_URL=postgresql://bi:bi@localhost:5432/bi
DATABASE_BACKEND_READER_URL=postgresql://backend_reader:backend_reader@localhost:5432/bi

SOURCE_CSV_BUCKET=seeds/csv
SOURCE_XLSX_BUCKET=seeds/xlsx
SOURCE_API_BASE_URL=http://localhost:8099
SOURCE_API_TOKEN=dev-token
SOURCE_ERP_DSN=postgresql://bi:bi@localhost:5432/bi

KALODATA_API_KEY=
KALODATA_REGION=US
KALODATA_LANGUAGE=en-US
KALODATA_CURRENCY=USD

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_PROMPT_VERSION=storyboard-v1

CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP=64

RETRIEVAL_RRF_K=60
RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_TOP_K=50
RETRIEVAL_LEG_K=50
RETRIEVAL_TRIGRAM_THRESHOLD=0.2
RETRIEVAL_EMBEDDER_MODEL_ID=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RETRIEVAL_RERANKER_MODEL_ID=Xenova/ms-marco-MiniLM-L-6-v2
RETRIEVAL_RERANK_MIN_SCORE=0.0
RETRIEVAL_CANDIDATE_K=50
RETRIEVAL_TRENDING_HALF_LIFE_DAYS=14.0

QUALITY_MAX_REJECTED_RATIO=0.05
QUALITY_BLOCKING=true

EVAL_DATASET_PATH=evaluation/datasets/retrieval.jsonl
EVAL_REPORT_DIR=evaluation/reports
EVAL_MIN_F1=0.5

API_HOST=0.0.0.0
API_PORT=8002

# Vi tri file nay: data/.env.example
APP_NAME=beyond-intelligence-data
ENVIRONMENT=development

LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
LLM_GEMINI_API_KEY=

# TODO(config): xac nhan dung ten header xac thuc that cua Kalodata
KALODATA_API_KEY=
KALODATA_AUTH_HEADER_NAME=Authorization
KALODATA_AUTH_HEADER_PREFIX=Bearer 

OBSERVABILITY_LOG_LEVEL=INFO
MAX_INSIGHT_REVISIONS=3
RANKING_PAGE_SIZE=20
TOP_N_FOR_DETAIL=10

# --- DeepSeek qua BytePlus ModelArk (thay the LLM_PROVIDER=gemini) ---
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-v4-flash-260425
# LLM_DEEPSEEK_API_KEY=

# Danh sach nhom du lieu Kalodata query dong thoi (phan cach dau phay)
# Gia tri hop le: video,product,shop,creator,category,livestream
INSIGHT_DOMAINS=video,product,category

# =============================================================================
# .env.example -- MAU khai bao bien moi truong cho agent/.
#
# Cach dung:
#   1. Copy file nay thanh `.env`:  cp .env.example .env
#   2. Dien gia tri that vao `.env` (dac biet la API key).
#   3. KHONG BAO GIO commit file `.env` that len git -- da co trong .gitignore.
#
# Thu tu uu tien: bien moi truong that (export/CI-CD) > file .env > default
# trong agent/config/settings.py.
# =============================================================================

# --- App chung ---
APP_NAME=beyond-intelligence-agent
ENVIRONMENT=development          # development | staging | production

# --- API Seedance ---
VIDEO_MODEL=dreamina-seedance-2-0-260128
VIDEO_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
VIDEO_API_KEY=<key_that_cua_ban>

# --- LLM (prefix: LLM_) ---
LLM_PROVIDER=gemini              # gemini | openai | anthropic | mock
LLM_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30

# Secret -- BAT BUOC dien khi LLM_PROVIDER=gemini. Lay tai https://aistudio.google.com/apikey
LLM_GEMINI_API_KEY=

# Chi dien neu dung provider tuong ung
LLM_OPENAI_API_KEY=
LLM_ANTHROPIC_API_KEY=

# --- DecisionPolicy (prefix: DECISION_) ---
DECISION_AUTO_EXECUTE_THRESHOLD=0.85
DECISION_REJECT_THRESHOLD=0.3
DECISION_ALLOW_HIGH_RISK_AUTO_EXECUTE=false

# --- RetryPolicy (prefix: RETRY_) ---
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1.0
RETRY_MAX_DELAY_SECONDS=30.0
RETRY_BACKOFF_MULTIPLIER=2.0

# --- ToolPolicy (prefix: TOOL_) ---
TOOL_AUTO_DENY_UNKNOWN_TOOLS=true

# --- Observability (prefix: OBSERVABILITY_) ---
OBSERVABILITY_LOG_LEVEL=INFO     # DEBUG | INFO | WARNING | ERROR
OBSERVABILITY_LOG_PROMPTS=false  # true chi nen dung khi debug local, KHONG bat o production
OBSERVABILITY_TRACING_ENABLED=false
OBSERVABILITY_TRACING_ENDPOINT=

# --- Application behavior chung ---
MAX_ITERATIONS=10
RETRIEVAL_TOP_K=5

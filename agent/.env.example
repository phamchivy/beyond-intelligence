# =============================================================================
# .env.example -- template for agent/.env (HTTP Agent pod, port 8001)
#
# Usage:
#   1. cp .env.example .env
#   2. Fill secrets in .env (LLM key + VIDEO_API_KEY)
#   3. Never commit .env -- it is gitignored
#
# Docker:
#   docker run --env-file agent/.env -p 8001:8001 \
#     phamchivy/agent-beyond-intelligence:demo-v1.1
#
# Priority: real env (export/CI) > agent/.env > defaults in config/settings.py
# Compose healthcheck hits GET /health -- VIDEO_PROVIDER=seedance without
# VIDEO_API_KEY returns 503 and the container is marked unhealthy.
# =============================================================================

# --- App ---
APP_NAME=beyond-intelligence-agent
ENVIRONMENT=development          # development | staging | production

# --- LLM (prefix: LLM_) ---
# gemini | openai | anthropic | deepseek | mock
LLM_PROVIDER=deepseek
LLM_MODEL=ep-m-20260821112825-vwdwh
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30
LLM_THINKING_LEVEL=low           # gemini 3.x only: low | high
# BytePlus ModelArk (OpenAI-compatible). Used when LLM_PROVIDER=deepseek.
LLM_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Set the key that matches LLM_PROVIDER. Leave others empty.
LLM_DEEPSEEK_API_KEY=
LLM_GEMINI_API_KEY=
LLM_OPENAI_API_KEY=
LLM_ANTHROPIC_API_KEY=

# --- Video renderer (prefix: VIDEO_) ---
# seedance = real BytePlus Seedance (needs VIDEO_API_KEY)
# mock     = no key; GET /health stays 200; render jobs are fake
VIDEO_PROVIDER=seedance
VIDEO_API_KEY=
VIDEO_MODEL=dreamina-seedance-2-0-260128
VIDEO_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
VIDEO_TIMEOUT_SECONDS=120

# --- DecisionPolicy (prefix: DECISION_) ---
DECISION_AUTO_EXECUTE_THRESHOLD=0.85
DECISION_REJECT_THRESHOLD=0.3
DECISION_ALLOW_HIGH_RISK_AUTO_EXECUTE=false

# --- RetryPolicy (prefix: RETRY_) ---
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1.0
RETRY_MAX_DELAY_SECONDS=30.0
RETRY_BACKOFF_MULTIPLIER=2.0

# --- ToolPolicy (prefix: TOOL_) ---
TOOL_AUTO_DENY_UNKNOWN_TOOLS=true

# --- Observability (prefix: OBSERVABILITY_) ---
OBSERVABILITY_LOG_LEVEL=INFO     # DEBUG | INFO | WARNING | ERROR
OBSERVABILITY_LOG_PROMPTS=false
OBSERVABILITY_TRACING_ENABLED=false
OBSERVABILITY_TRACING_ENDPOINT=

# --- App behavior ---
MAX_ITERATIONS=10
RETRIEVAL_TOP_K=5
MAX_STORYBOARD_REVISIONS=3
